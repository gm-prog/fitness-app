PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/fitness-app

# Hugging Face Inference (AI provider)
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# The model MUST list at least one Inference Provider on its Hugging Face model
# page, otherwise every request fails with "We have not been able to find
# inference provider information for model ...".
# Verified default: Qwen/Qwen3-4B-Instruct-2507 is served by Nscale
# (task: text-generation).
# To switch models, open https://huggingface.co/<model> and confirm the
# "Inference Providers" section lists a provider before setting HF_MODEL.
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# "auto" asks Hugging Face to pick an available provider for the model. Nscale
# is currently the only provider serving the default model, so "auto" resolves
# to it. Pin it explicitly with:
HF_PROVIDER=auto
# HF_PROVIDER=nscale

# Optional tuning. Must be numeric or the server refuses to start.
# HF_MAX_TOKENS: whole number, 1-8192 (default 2000)
# HF_TEMPERATURE: decimal, 0-2 (default 0.7)
HF_MAX_TOKENS=2000
HF_TEMPERATURE=0.7

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
