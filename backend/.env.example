PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/fitness-app

# Hugging Face Inference (AI provider)
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# Any model your token can access AND the selected provider supports.
# Non-gated, broadly supported options include:
#   mistralai/Mistral-7B-Instruct-v0.3
#   Qwen/Qwen2.5-7B-Instruct
#   Qwen/Qwen2.5-72B-Instruct
#   HuggingFaceH4/zephyr-7b-beta
# Gated models (e.g. meta-llama/*, google/gemma-*) require you to accept the
# model licence on the Hub first, otherwise requests return 403.
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# "auto" picks the best available provider. Pin one if needed:
# together, fal-ai, nebius, groq, hyperbolic, novita, hf-inference, ...
HF_PROVIDER=auto
# Optional tuning
HF_MAX_TOKENS=2000
HF_TEMPERATURE=0.7

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
